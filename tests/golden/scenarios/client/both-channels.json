{
  "description": "Both channels in one process: braille notifications are spoken because a display is connected, and capsLockToggle on the braille channel.",
  "args": [
    "--language",
    "fr_FR",
    "--sync-caps-lock"
  ],
  "env": {
    "DISPLAY": ":0"
  },
  "control": {
    "capslock": "on"
  },
  "startup_trace": [
    {
      "src": "atspi",
      "call": "registerEventListener",
      "args": [
        "window:deactivate"
      ]
    },
    {
      "src": "brlapi",
      "call": "ignoreKeys",
      "args": [
        1,
        [
          0
        ]
      ]
    }
  ],
  "steps": [
    {
      "wait_trace": {
        "src": "brlapi",
        "call": "ignoreKeys"
      }
    },
    {
      "connect": "speech"
    },
    {
      "send": "speech",
      "fixture": "server-protocol-version-v1.hex"
    },
    {
      "send": "speech",
      "fixture": "server-protocol-version-v2-jsonl.hex"
    },
    {
      "connect": "braille"
    },
    {
      "send": "braille",
      "fixture": "braille-server-protocol-version-v1.hex"
    },
    {
      "send": "braille",
      "json": [
        {
          "type": "protocol_version",
          "version": 2,
          "channel": "NVDA-BRAILLE"
        }
      ]
    },
    {
      "send": "speech",
      "json": [
        {
          "type": "speak",
          "sequence": [
            "ensemble",
            [
              "IndexCommand",
              {
                "index": 1
              }
            ]
          ]
        }
      ]
    },
    {
      "send": "braille",
      "json": [
        {
          "type": "display",
          "cells": [
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3,
            3
          ]
        }
      ]
    },
    {
      "send": "braille",
      "json": [
        {
          "type": "attribute_value",
          "attribute": "capsLockToggle",
          "value": false
        }
      ],
      "settle": true
    },
    {
      "disconnect": "braille"
    },
    {
      "send": "speech",
      "json": [
        {
          "type": "speak",
          "sequence": [
            "encore",
            [
              "IndexCommand",
              {
                "index": 2
              }
            ]
          ]
        }
      ]
    }
  ]
}
