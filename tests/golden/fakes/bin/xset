#!/usr/bin/env python3
"""Golden fake ``xset q``: Caps Lock state from the control file ``capslock``."""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

import golden_trace

golden_trace.record("xset", "run", sys.argv[1:])
path = golden_trace.control_path("capslock")
state = path.read_text().strip() if path.exists() else "off"
print(f"Keyboard Control:\n  00: Caps Lock:   {state}    01: Num Lock:    off")
