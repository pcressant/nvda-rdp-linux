# Maintainer: Patrick Cressant <patrick.cressant@gmail.com>
pkgname=nvda-rdp-linux-git
_pkgname=nvda-rdp-linux
pkgver=0.2.0
pkgrel=1
pkgdesc="Linux client for NVDA's RDAccess: remote NVDA speech and braille over RDP"
arch=('x86_64' 'aarch64')
url="https://github.com/pcressant/nvda-rdp-linux"
license=('GPL-2.0-or-later')
depends=(
  'at-spi2-core'
  'brltty'
  'freerdp'
  'pipewire-audio' # pw-play
  'python'
  'python-atspi'
  'python-brltty' # brlapi module
  'python-gobject'
  'speech-dispatcher' # also provides the speechd module
)
makedepends=(
  'cmake'
  'git'
  'ninja'
  'python-build'
  'python-installer'
  'python-setuptools'
)
checkdepends=('python-pytest')
optdepends=(
  'remmina: graphical RDP client (set "Dynamic virtual channel" to nvda-rdp-dvc)'
  'xdotool: --sync-caps-lock'
  'xorg-xset: --sync-caps-lock'
)
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  if git describe --long --tags >/dev/null 2>&1; then
    git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    printf '0.2.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  fi
}

build() {
  cd "$_pkgname"
  cmake -S freerdp-plugin -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
  python -m build --wheel --no-isolation
}

check() {
  cd "$_pkgname"
  python -m pytest -q -p no:cacheprovider
}

package() {
  cd "$_pkgname"
  DESTDIR="$pkgdir" cmake --install build
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 packaging/systemd/nvda-rdp-client.service \
    "$pkgdir/usr/lib/systemd/user/nvda-rdp-client.service"
  install -Dm644 README.md run.md -t "$pkgdir/usr/share/doc/$_pkgname"
}
