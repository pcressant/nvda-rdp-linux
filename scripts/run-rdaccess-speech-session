#!/usr/bin/env bash
set -euo pipefail

project_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$project_dir"
mkdir -p logs

: "${RDP_HOST:?Set RDP_HOST to the Windows RDP host}"
: "${RDP_USER:?Set RDP_USER to the Windows account name}"
RDP_DOMAIN=${RDP_DOMAIN:-}
# Optional: a copy of NVDA's "waves" directory, used for NVDA sounds and
# connection sounds forwarded by RDAccess.
NVDA_WAVES_DIR=${NVDA_WAVES_DIR:-}
if [[ -z "$NVDA_WAVES_DIR" && -d "$project_dir/nvda-waves" ]]; then
  NVDA_WAVES_DIR=$project_dir/nvda-waves
fi
# Optional extra options, split on spaces, e.g. "--settings-management".
RDACCESS_SPEECH_OPTIONS=${RDACCESS_SPEECH_OPTIONS:-}
RDACCESS_BRAILLE_OPTIONS=${RDACCESS_BRAILLE_OPTIONS:-}
export RDP_HOST RDP_USER RDP_DOMAIN NVDA_WAVES_DIR
export RDACCESS_SPEECH_OPTIONS RDACCESS_BRAILLE_OPTIONS

set +e
nix develop --command bash -c '
  set -euo pipefail

  socket_path=${NVDA_RDP_SOCKET:-"$XDG_RUNTIME_DIR/nvda-rdp-linux/speech.sock"}
  braille_socket_path=${NVDA_RDP_BRAILLE_SOCKET:-"$XDG_RUNTIME_DIR/nvda-rdp-linux/braille.sock"}
  waves_options=()
  if [[ -n "$NVDA_WAVES_DIR" ]]; then
    waves_options=(--nvda-waves-dir "$NVDA_WAVES_DIR")
  fi
  read -r -a speech_options <<< "$RDACCESS_SPEECH_OPTIONS"
  read -r -a braille_options <<< "$RDACCESS_BRAILLE_OPTIONS"
  python -m client.main "${waves_options[@]}" "${speech_options[@]}" \
    > logs/rdaccess-client.log 2>&1 &
  client_pid=$!
  python -m client.braille_main --brlapi "${waves_options[@]}" "${braille_options[@]}" \
    > logs/rdaccess-braille.log 2>&1 &
  braille_client_pid=$!

  cleanup() {
    kill -TERM "$client_pid" 2>/dev/null || true
    kill -TERM "$braille_client_pid" 2>/dev/null || true
    wait "$client_pid" 2>/dev/null || true
    wait "$braille_client_pid" 2>/dev/null || true
  }
  trap cleanup EXIT

  for _attempt in $(seq 1 50); do
    if [[ -S "$socket_path" ]]; then
      break
    fi
    if ! kill -0 "$client_pid" 2>/dev/null; then
      echo "The RDAccess speech client stopped before creating $socket_path" >&2
      exit 1
    fi
    sleep 0.1
  done
  if [[ ! -S "$socket_path" ]]; then
    echo "The RDAccess speech socket was not created: $socket_path" >&2
    exit 1
  fi
  for _attempt in $(seq 1 50); do
    if [[ -S "$braille_socket_path" ]]; then
      break
    fi
    if ! kill -0 "$braille_client_pid" 2>/dev/null; then
      echo "The RDAccess braille client stopped before creating $braille_socket_path" >&2
      exit 1
    fi
    sleep 0.1
  done
  if [[ ! -S "$braille_socket_path" ]]; then
    echo "The RDAccess braille socket was not created: $braille_socket_path" >&2
    exit 1
  fi

  read -r -s -p "RDP password: " rdp_password
  printf "\n"

  rdp_target=("/v:$RDP_HOST" "/u:$RDP_USER")
  if [[ -n "$RDP_DOMAIN" ]]; then
    rdp_target+=("/d:$RDP_DOMAIN")
  fi

  set +e
  printf "%s\n" "$rdp_password" | stdbuf -oL -eL xfreerdp \
    "${rdp_target[@]}" \
    /dvc:nvda-rdp-dvc \
    /from-stdin:force \
    /cert:tofu \
    /sound:sys:pulse \
    /kbd:layout:0x0000040C \
    +f \
    +grab-keyboard \
    /log-level:INFO \
    /log-filters:com.freerdp.channels.drdynvc.client:TRACE \
    > logs/rdaccess-speech-session.log 2>&1
  status=${PIPESTATUS[1]}
  unset rdp_password
  set -e
  exit "$status"
'
status=$?
set -e

printf '\nThe session stopped with exit code %d. Press Enter to close.\n' "$status"
read -r
exit "$status"
