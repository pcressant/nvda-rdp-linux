{
  "description": "Real RDAccess 2.0.0 braille negotiation captures with a 40-cell BrlAPI display.",
  "args": [
    "--no-speech",
    "--language",
    "fr_FR"
  ],
  "startup_trace": [
    {
      "src": "atspi",
      "call": "registerEventListener",
      "args": [
        "window:deactivate"
      ]
    },
    {
      "src": "brlapi",
      "call": "ignoreKeys",
      "args": [
        1,
        [
          0
        ]
      ]
    }
  ],
  "steps": [
    {
      "wait_trace": {
        "src": "brlapi",
        "call": "ignoreKeys"
      }
    },
    {
      "connect": "braille"
    },
    {
      "send": "braille",
      "fixture": "braille-server-protocol-version-v1.hex"
    },
    {
      "send": "braille",
      "fixture": "braille-server-num-rows-request-v1.hex",
      "split": [
        7
      ]
    },
    {
      "send": "braille",
      "fixture": "braille-server-num-cols-request-v1.hex"
    },
    {
      "send": "braille",
      "json": [
        {
          "type": "protocol_version",
          "version": 2,
          "channel": "NVDA-BRAILLE"
        }
      ]
    },
    {
      "send": "braille",
      "fixture": "braille-server-gesture-map-request-v1.hex"
    },
    {
      "send": "braille",
      "fixture": "first-braille-display-v2-jsonl.hex"
    },
    {
      "send": "braille",
      "json": [
        {
          "type": "attribute_request",
          "attribute": "numCells"
        },
        {
          "type": "attribute_request",
          "attribute": "numRows"
        },
        {
          "type": "attribute_request",
          "attribute": "supportedSettings"
        },
        {
          "type": "attribute_request",
          "attribute": "setting_brailleTable"
        },
        {
          "type": "attribute_request",
          "attribute": "availableTables"
        },
        {
          "type": "attribute_request",
          "attribute": "other"
        }
      ]
    }
  ]
}
