pkgbase = nvda-rdp-linux-git
	pkgdesc = NVDA's RDAccess on Linux: remote speech and braille over RDP
	pkgver = 0.5.0
	pkgrel = 1
	url = https://github.com/pcressant/nvda-rdp-linux
	arch = x86_64
	arch = aarch64
	license = GPL-2.0-or-later
	checkdepends = brltty
	checkdepends = dbus
	checkdepends = liblouis
	checkdepends = python-atspi
	checkdepends = python-brltty
	checkdepends = python-gobject
	checkdepends = python-pytest
	checkdepends = speech-dispatcher
	makedepends = cmake
	makedepends = freerdp
	makedepends = git
	makedepends = ninja
	makedepends = python
	source = nvda-rdp-linux::git+https://github.com/pcressant/nvda-rdp-linux.git
	sha256sums = SKIP

pkgname = nvda-rdp-common-git
	pkgdesc = NVDA's RDAccess on Linux: code shared by the client and the server
	arch = any
	depends = python
	provides = nvda-rdp-common
	conflicts = nvda-rdp-common

pkgname = nvda-rdp-freerdp-plugin-git
	pkgdesc = NVDA's RDAccess on Linux: FreeRDP plugin of the RDAccess channels
	depends = freerdp
	provides = nvda-rdp-freerdp-plugin
	conflicts = nvda-rdp-freerdp-plugin
	conflicts = nvda-rdp-linux
	conflicts = nvda-rdp-linux-git
	replaces = nvda-rdp-linux-git

pkgname = nvda-rdp-client-git
	pkgdesc = NVDA's RDAccess on Linux: client for a remote NVDA's speech and braille
	arch = any
	depends = nvda-rdp-common-git=0.5.0-1
	depends = nvda-rdp-freerdp-plugin-git
	depends = at-spi2-core
	depends = brltty
	depends = pipewire-audio
	depends = python
	depends = python-atspi
	depends = python-brltty
	depends = python-gobject
	depends = speech-dispatcher
	optdepends = remmina: graphical RDP client (set "Dynamic virtual channel" to nvda-rdp-dvc)
	optdepends = xdotool: --sync-caps-lock
	optdepends = xorg-xset: --sync-caps-lock
	provides = nvda-rdp-client
	conflicts = nvda-rdp-client
	conflicts = nvda-rdp-linux
	conflicts = nvda-rdp-linux-git
	replaces = nvda-rdp-linux-git

pkgname = nvda-rdp-server-git
	pkgdesc = NVDA's RDAccess on Linux: Orca's speech and braille for NVDA over GNOME Remote Desktop
	depends = nvda-rdp-common-git=0.5.0-1
	depends = gdm
	depends = glib2
	depends = gnome-remote-desktop
	depends = liblouis
	depends = orca
	depends = python
	depends = python-gobject
	depends = speech-dispatcher
	depends = systemd
	provides = nvda-rdp-server
	conflicts = nvda-rdp-server
