#!/usr/bin/env bash
set -euo pipefail

project_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$project_dir"
mkdir -p logs

: "${RDP_HOST:?Set RDP_HOST to the Windows RDP host}"
: "${RDP_USER:?Set RDP_USER to the Windows account name}"
RDP_DOMAIN=${RDP_DOMAIN:-}
# Optional: a copy of NVDA's "waves" directory, used for NVDA sounds and
# connection sounds forwarded by RDAccess.
NVDA_WAVES_DIR=${NVDA_WAVES_DIR:-}
if [[ -z "$NVDA_WAVES_DIR" && -d "$project_dir/nvda-waves" ]]; then
  NVDA_WAVES_DIR=$project_dir/nvda-waves
fi
# Optional extra client options, split on spaces, e.g. "--settings-management".
RDACCESS_CLIENT_OPTIONS=${RDACCESS_CLIENT_OPTIONS:-}
export RDP_HOST RDP_USER RDP_DOMAIN NVDA_WAVES_DIR RDACCESS_CLIENT_OPTIONS

set +e
nix develop --command bash -c '
  set -euo pipefail

  socket_path=${NVDA_RDP_SOCKET:-"$XDG_RUNTIME_DIR/nvda-rdp-linux/speech.sock"}
  braille_socket_path=${NVDA_RDP_BRAILLE_SOCKET:-"$XDG_RUNTIME_DIR/nvda-rdp-linux/braille.sock"}
  read -r -a client_options <<< "$RDACCESS_CLIENT_OPTIONS"
  client_pid=""
  cleanup() {
    if [[ -n "$client_pid" ]]; then
      kill -TERM "$client_pid" 2>/dev/null || true
      wait "$client_pid" 2>/dev/null || true
    fi
  }
  trap cleanup EXIT

  if systemctl --user --quiet is-active nvda-rdp-client.service 2>/dev/null; then
    echo "Using the running nvda-rdp-client user service."
    echo "Its log: journalctl --user -u nvda-rdp-client"
  else
    python -m nvda_rdp_linux "${client_options[@]}" > logs/nvda-rdp-client.log 2>&1 &
    client_pid=$!

    for _attempt in $(seq 1 50); do
      if [[ -S "$socket_path" && -S "$braille_socket_path" ]]; then
        break
      fi
      if ! kill -0 "$client_pid" 2>/dev/null; then
        echo "The RDAccess client stopped; see logs/nvda-rdp-client.log" >&2
        exit 1
      fi
      sleep 0.1
    done
    if [[ ! -S "$socket_path" || ! -S "$braille_socket_path" ]]; then
      echo "The RDAccess client sockets were not created; see logs/nvda-rdp-client.log" >&2
      exit 1
    fi
  fi

  read -r -s -p "RDP password: " rdp_password
  printf "\n"

  rdp_target=("/v:$RDP_HOST" "/u:$RDP_USER")
  if [[ -n "$RDP_DOMAIN" ]]; then
    rdp_target+=("/d:$RDP_DOMAIN")
  fi

  set +e
  printf "%s\n" "$rdp_password" | stdbuf -oL -eL xfreerdp \
    "${rdp_target[@]}" \
    /dvc:nvda-rdp-dvc \
    /from-stdin:force \
    /cert:tofu \
    /sound:sys:pulse \
    /kbd:layout:0x0000040C \
    +f \
    +grab-keyboard \
    /log-level:INFO \
    /log-filters:com.freerdp.channels.drdynvc.client:TRACE \
    > logs/rdaccess-speech-session.log 2>&1
  status=${PIPESTATUS[1]}
  unset rdp_password
  set -e
  exit "$status"
'
status=$?
set -e

printf '\nThe session stopped with exit code %d. Press Enter to close.\n' "$status"
read -r
exit "$status"
